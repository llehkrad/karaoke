{
  "manifest_version": 3,
  "name": "Sing! Pitch Sync",
  "version": "1.0.0",
  "description": "Captures the Host Display tab's audio and pitch-shifts it live to match the song's chosen key. No virtual audio device needed.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["tabCapture", "offscreen", "storage", "activeTab"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://localhost/host/*", "https://*/host/*"],
      "js": ["content-detect.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Karaoke Pitch Sync",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
