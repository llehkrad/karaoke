# Copy this file to .env and fill in real values.

PORT=3001

# Restrict this to your actual frontend URL in production, e.g. https://karaoke.yourdomain.com
CORS_ORIGIN=*

# Get this from https://console.cloud.google.com/apis/credentials
# (enable "YouTube Data API v3" on the project first)
YOUTUBE_API_KEY=

# Optional: override where the SQLite database file is stored
# DB_PATH=./data/karaoke.db

# Required for the /admin control panel (list all rooms, adjust pitch
# live, pause/resume/restart playback, skip). Pick any strong password --
# it acts as a master key valid for every room. Leave unset to disable
# /admin entirely.
ADMIN_PASSWORD=
