# Copy this file to .env and fill in real values.

PORT=3001

# Restrict this to your actual frontend URL in production, e.g. https://sing.everythinglah.com
# Comma-separate multiple origins, e.g. if using the pitch-sync Chrome extension:
# CORS_ORIGIN=https://sing.everythinglah.com,chrome-extension://<extension-id>
CORS_ORIGIN=*

# Get this from https://console.cloud.google.com/apis/credentials
# (enable "YouTube Data API v3" on the project first)
YOUTUBE_API_KEY=

# Optional: override where the SQLite database file is stored
# DB_PATH=./data/karaoke.db

# Admin user credentials - used to initialize the first admin user in the database
# Both required to create default admin account. Can be any username/password.
# After the app runs once, you can add more users via the database or future admin panel.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your-secure-password-here
